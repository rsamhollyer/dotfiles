#!/bin/env bash
xrdb -load ~/.Xresources
xrdb -merge ~/.Xresources

# xrandr --output DP-1 --primary --mode 2560x1440 --rate 164.83 --output DP-2 --mode 2560x1440 --rate 164.83
xrandr --output DP-1 --primary --auto --output DP-2 --mode 2560x1440 --rate 164.83

[[ -f ~/.config/zsh/.zshenv ]] && source ~/.config/zsh/.zshenv
xfce4-power-manager &
sxhkd &
dunst &
# picom &

[[ -f ~/.fehbg ]] && ~/.fehbg &

numlockx &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
pgrep -x redshift >/dev/null || redshift -P -c ~/.config/redshift.conf &
# pgrep -x pipewire >/dev/null || /usr/bin/pipewire &
# pgrep -x pipewire-pulse >/dev/null || /usr/bin/pipewire-pulse &
# pgrep -x wireplumber >/dev/null || /usr/bin/wireplumber &
xset s off
xset s noblank
xset -dpms
