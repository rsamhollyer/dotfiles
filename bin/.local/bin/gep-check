#!/usr/bin/env bash
# Check and notify if GE is updated https://github.com/gloriouseggroll/proton-ge-custom/releases

set -euo pipefail

API="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
DEST="$HOME/.steam/root/compatibilitytools.d"
STATE="$HOME/.cache/gep-check-last"

tag=$(curl -fsSL --retry 5 --retry-delay 30 --retry-all-errors "$API" | jq -r '.tag_name')

[[ -n $tag && $tag != null ]] || { echo "Could not read the latest version." >&2; exit 1; }
[[ -d $DEST/$tag-x86_64 ]] && exit 0
[[ -f $STATE && $(<"$STATE") == "$tag" ]] && exit 0

notify-send -i software-update-available "GE-Proton update available" "$tag is out. Run gep-update to install it."

mkdir -p "$(dirname "$STATE")"
printf '%s\n' "$tag" >"$STATE"